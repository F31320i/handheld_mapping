Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
      Splitter Ratio: 0.5
    Tree Height: 700
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: LiDAR (adapted)
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /livox/lidar_livo
      Style: Points
      Size (Pixels): 2
      Size (m): 0.01
      Color Transformer: AxisColor
      Axis: Z
      Autocompute Intensity Bounds: true
      Position Transformer: XYZ
      Queue Size: 5
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Marker Scale: 0.5
  Enabled: true
  Global Options:
    # The LiDAR body frame: the rig is not localised in this view, so there is
    # nothing above it and no map->odom to wait for. /livox/lidar (CustomMsg)
    # cannot be displayed by rviz at all -- that is what /livox/lidar_livo is.
    Fixed Frame: livox_mid360_frame
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.6
      Yaw: 0.8
      Name: Current View
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 800
  Width: 1200
